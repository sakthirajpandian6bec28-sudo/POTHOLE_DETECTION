# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Model Configuration
MODEL_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Upload Constraints
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/quicktime

# Severity Thresholds (bbox area / frame area or confidence-based ratio)
SEVERITY_LOW_MAX=0.02
SEVERITY_MEDIUM_MAX=0.08

# Security & CORS (Use * to allow all cloud origins or provide comma-separated URLs)
CORS_ORIGINS=*

# Database Connection
DATABASE_URL=sqlite:///./potholes.db
